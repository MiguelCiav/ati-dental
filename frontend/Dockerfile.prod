# ============================================================
# Dockerfile.prod — Build de producción autosuficiente (multi-stage)
#
# Stage 1 (builder): instala dependencias y compila el bundle con Vite.
# Stage 2 (runtime): copia el /dist al Nginx ligero y lo sirve.
#
# Al ser un multi-stage real, no necesita ninguna imagen externa
# pre-construida (como frontend-app:build), por lo que funciona
# correctamente con Docker BuildKit activado.
# ============================================================

# --- Stage 1: Compilación ---
FROM node:20-alpine AS builder

WORKDIR /app

# Aprovecha la caché de capas: si package.json no cambia, npm install se reutiliza
COPY package*.json ./
RUN npm install

# Copia el resto del código y compila con Vite → /app/dist
COPY . .
RUN npm run build

# --- Stage 2: Imagen de producción ligera con Nginx ---
FROM nginx:alpine

# Elimina la página por defecto de Nginx
RUN rm -rf /usr/share/nginx/html/*

# Copia el bundle compilado desde el stage anterior
COPY --from=builder /app/dist /usr/share/nginx/html/

# Configuración de Nginx para SPA (React Router compatible)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
