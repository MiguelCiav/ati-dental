# Imagen base ligera sugerida por el laboratorio 
FROM postman/newman:6-alpine

# Directorio de trabajo para las colecciones
WORKDIR /etc/newman

# Copiamos los archivos de la colección y ambiente
COPY . .

# Entrypoint: sin argumentos → itera todas las colecciones compartiendo token via globals
#             con argumentos → pasa directo a newman (ej. para correr una colección específica)
RUN echo '#!/bin/sh' > /run_collections.sh && \
    echo 'if [ -z "$1" ]; then' >> /run_collections.sh && \
    echo '  echo "{}" > /tmp/globals.json' >> /run_collections.sh && \
    echo '  for col in collections/*.json; do' >> /run_collections.sh && \
    echo '    echo "Ejecutando colección: $col"' >> /run_collections.sh && \
    echo '    newman run "$col" --globals /tmp/globals.json --export-globals /tmp/globals.json' >> /run_collections.sh && \
    echo '  done' >> /run_collections.sh && \
    echo 'else' >> /run_collections.sh && \
    echo '  newman run "$@"' >> /run_collections.sh && \
    echo 'fi' >> /run_collections.sh && \
    chmod +x /run_collections.sh

ENTRYPOINT ["/run_collections.sh"]