		{
			"name": "POST /api/auth/login - Autenticarse y obtener token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Login exitoso - Estado 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Respuesta contiene token JWT', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data.token).to.be.a('string');",
							"    // Guardar el token como variable de colección para las siguientes peticiones",
							"    pm.collectionVariables.set('authToken', jsonData.data.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\"email\":\"admin@atidental.com\",\"password\":\"password123\"}"
				},
				"url": {
					"raw": "http://api:3000/api/auth/login",
					"protocol": "http",
					"host": [
						"api"
					],
					"port": "3000",
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET /api/patients - Obtener todos los pacientes",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Estado es 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Respuesta es un array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});",
							"",
							"pm.test('Los pacientes tienen la estructura correcta', function () {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.length > 0) {",
							"        const patient = jsonData[0];",
							"        pm.expect(patient).to.have.property('id');",
							"        pm.expect(patient).to.have.property('nombre');",
							"        pm.expect(patient).to.have.property('email');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"url": {
					"raw": "http://api:3000/api/patients",
					"protocol": "http",
					"host": [
						"api"
					],
					"port": "3000",
					"path": [
						"api",
						"patients"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET /api/patients?search=Maria - Buscar paciente por nombre",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Estado es 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Solo devuelve pacientes que coinciden con María', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    ",
							"    jsonData.forEach(function(patient) {",
							"        const matchesSearch = ",
							"            patient.nombre.toLowerCase().includes('maria') ||",
							"            patient.email.toLowerCase().includes('maria');",
							"        pm.expect(matchesSearch).to.be.true;",
							"    });",
							"});",
							"",
							"pm.test('Encuentra a María González', function () {",
							"    const jsonData = pm.response.json();",
							"    const maria = jsonData.find(p => p.nombre.includes('María González'));",
							"    pm.expect(maria).to.exist;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"url": {
					"raw": "http://api:3000/api/patients?search=Maria",
					"protocol": "http",
					"host": [
						"api"
					],
					"port": "3000",
					"path": [
						"api",
						"patients"
					],
					"query": [
						{
							"key": "search",
							"value": "Maria"
						}
					]
				}
			},
			"response": []
		},
