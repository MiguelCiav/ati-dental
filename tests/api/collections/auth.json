{
  "info": {
    "name": "Auth API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Validar API Running",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado es 200', function () { pm.response.to.have.status(200); });",
              "pm.test('El ambiente es development', function () { pm.expect(pm.response.json().environment).to.eql('development'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://api:3000/",
          "protocol": "http",
          "host": [
            "api"
          ],
          "port": "3000",
          "path": [
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST /api/auth/login - Autenticarse y obtener token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login exitoso - Estado 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Respuesta contiene token JWT', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.token).to.be.a('string');",
              "    // Guardar el token como variable de colección para las siguientes peticiones",
              "    pm.collectionVariables.set('authToken', jsonData.data.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@atidental.com\",\"password\":\"password123\"}"
        },
        "url": {
          "raw": "http://api:3000/api/auth/login",
          "protocol": "http",
          "host": [
            "api"
          ],
          "port": "3000",
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "lastCreatedPatientId",
      "value": ""
    }
  ]
}