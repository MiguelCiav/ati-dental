    {
      "name": "GET /api/patients?search=González - Buscar por apellido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Solo devuelve registros que coinciden con González', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    ",
              "    jsonData.forEach(function(patient) {",
              "        const matchesSearch = ",
              "            patient.nombre.toLowerCase().includes('gonzález') ||",
              "            patient.email.toLowerCase().includes('gonzález');",
              "        pm.expect(matchesSearch).to.be.true;",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "http://api:3000/api/patients?search=González",
          "protocol": "http",
          "host": [
            "api"
          ],
          "port": "3000",
          "path": [
            "api",
            "patients"
          ],
          "query": [
            {
              "key": "search",
              "value": "González"
            }
          ]
        }
      },
      "response": []
