    {
      "name": "POST /api/patients - Crear paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Paciente creado - Estado 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Respuesta contiene datos del paciente', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.nombre).to.eql('Paciente Postman');",
              "    pm.expect(jsonData.cedula).to.include('V-POSTMAN');",
              "    // Guardar ID para próxima petición",
              "    if (jsonData._id) {",
              "        pm.collectionVariables.set('lastCreatedPatientId', jsonData._id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\":\"Paciente Postman\",\"email\":\"postman_{{$randomInt}}@test.com\",\"telefono\":\"0000000\",\"cedula\":\"V-POSTMAN-{{$randomInt}}\",\"genero\":\"Masculino\",\"tipoSangre\":\"O+\",\"alergias\":\"Ninguna\",\"condicionesMedicas\":\"Ninguna\",\"notasAdicionales\":\"Prueba desde postman\"}"
        },
        "url": {
          "raw": "http://api:3000/api/patients",
          "protocol": "http",
          "host": [
            "api"
          ],
          "port": "3000",
          "path": [
            "api",
            "patients"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /api/patients/:id - Consultar Ficha de Paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Respuesta es el paciente correcto', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData._id).to.eql(pm.collectionVariables.get('lastCreatedPatientId'));",
              "    pm.expect(jsonData.nombre).to.eql('Paciente Postman');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "http://api:3000/api/patients/{{lastCreatedPatientId}}",
          "protocol": "http",
          "host": [
            "api"
          ],
          "port": "3000",
          "path": [
            "api",
            "patients",
            "{{lastCreatedPatientId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "PUT /api/patients/:id - Editar Paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Paciente actualizado - Estado 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Respuesta refleja los campos actualizados', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.nombre).to.eql('Paciente Postman Editado');",
              "    pm.expect(jsonData.direccion).to.eql('Nueva Direccion');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
